DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# AWS S3 for interview recordings
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=accionhire-recordings

PORT=8080
BOT_PORT=3978

# LLM (Groq / OpenAI-compatible)
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.groq.com/openai/v1
AI_INTEGRATIONS_OPENAI_API_KEY=your_groq_api_key

BOT_APP_ID=
BOT_APP_PASSWORD=
DEFAULT_RECRUITER_EMAIL=recruiter@company.com
DEFAULT_JOB_TITLE=Software Engineer
DEFAULT_JD=Job description here
BOT_API_KEY=your_bot_api_key

SLACK_BOT_TOKEN=xoxb-your-token
SLACK_SIGNING_SECRET=your_signing_secret
SLACK_APP_TOKEN=xapp-your-token

LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_URL=wss://your-livekit-host.livekit.cloud

# ElevenLabs (disabled — replaced by Sarvam AI TTS)
ELEVENLABS_API_KEY=your_api_key_here
ELEVENLABS_VOICE_ID=your_voice_id

# Sarvam AI TTS — required for AI interviewer voice
# Get your key at https://sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key

FRONTEND_URL=http://localhost:5173
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-gmail-app-password
